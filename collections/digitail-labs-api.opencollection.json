{
  "opencollection": "1.0.0",
  "info": {
    "name": "Digitail Open Appointments Labs API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://vet.digitail.io/oauth/authorize",
      "accessTokenUrl": "https://vet.digitail.io/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Labs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List labs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://developer.digitail.io/api/v1/labs",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (default 1)."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Results per page (default 15)."
              }
            ]
          },
          "docs": "List lab orders and results. Modeled from the documented Labs resource."
        }
      ]
    }
  ],
  "bundled": true
}