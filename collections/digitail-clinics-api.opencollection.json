{
  "opencollection": "1.0.0",
  "info": {
    "name": "Digitail Open Appointments Clinics API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://vet.digitail.io/oauth/authorize",
      "accessTokenUrl": "https://vet.digitail.io/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Clinics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a clinic",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://developer.digitail.io/api/v1/clinic/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Resource identifier."
              }
            ]
          },
          "docs": "Retrieve a single clinic record. Confirmed endpoint."
        }
      ]
    }
  ],
  "bundled": true
}